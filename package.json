{
  "name": "video-streamer",
  "version": "1.0.0",
  "description": "Minimalist Audio Streamer with Tailwind CSS v4",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css",
    "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --watch"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}